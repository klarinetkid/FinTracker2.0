{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Connection": "Server=ZACHPC\\SQLEXPRESS;User ID=FinTracker_DevUser;Password=abcd1234;Encrypt=False"
  },
  "AppSettings": {
    "ApiVersion": "1.0.3",
    "ResponsePageSize": 100,
    "OrderingRowLimit": 400000,
    "MaxTrendQueryDaySpan": 36500,
    "ClientURL": "http://localhost:5173"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/applog-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "ApplicationName": "FinTracker2.0"
    }
  }
}
